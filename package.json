{
  "name": "moh-srilanka",
  "version": "1.0.0",
  "description": "Root package for deployment on Render",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=client",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=client",
    "render-build": "npm install --include=optional && npm run build --workspace=client",
    "start": "npm start --workspace=server"
  },
  "engines": {
    "node": "20.x",
    "npm": ">=10.0.0"
  }
}